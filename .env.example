# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-this-to-random-string
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration
DATABASE_URI=sqlite:///unfollower_tracker.db

# Instagram Configuration (Optional - akan diminta saat login)
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=

# Session Configuration
SESSION_LIFETIME_HOURS=24
AUTO_CHECK_INTERVAL_HOURS=24

