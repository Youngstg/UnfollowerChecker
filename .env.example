# Flask Configuration
FLASK_SECRET_KEY=ganti-dengan-random-string-panjang-disini
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration
DATABASE_URI=sqlite:///unfollower_tracker.db

# Proxy Configuration (Sangat disarankan jika dideploy di VPS / Datacenter)
# Kosongkan jika IP VPS tidak diblokir Instagram.
# Jika menggunakan Cloudflare WARP di VPS: socks5://127.0.0.1:40000
# Jika menggunakan proxy residensial: http://user:password@ip:port
INSTAGRAM_PROXY=

# Session Configuration
SESSION_LIFETIME_HOURS=24
AUTO_CHECK_INTERVAL_HOURS=24
